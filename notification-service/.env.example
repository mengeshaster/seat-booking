DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seat_booking"
RABBITMQ_URL="amqp://localhost"
RABBITMQ_EXCHANGE="seat-booking.events"
RABBITMQ_NOTIFICATION_QUEUE="seat-booking.notifications"
RABBITMQ_NOTIFICATION_DLQ="seat-booking.notifications.dlq"
RABBITMQ_NOTIFICATION_RETRY_1M_QUEUE="seat-booking.notifications.retry.1m"
RABBITMQ_NOTIFICATION_RETRY_5M_QUEUE="seat-booking.notifications.retry.5m"
SMTP_HOST="localhost"
SMTP_PORT=1025
