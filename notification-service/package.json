{
  "name": "@seat-booking/notification-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/consumer.js",
  "scripts": {
    "dev": "tsx watch src/consumer.ts",
    "start": "node dist/src/consumer.js",
    "build": "pnpm --filter @seat-booking/observability build && pnpm --filter @seat-booking/messaging build && tsc",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@seat-booking/messaging": "workspace:*",
    "@seat-booking/observability": "workspace:*",
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^20.8.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
